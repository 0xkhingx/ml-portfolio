# Substack — optional. Set to your publication's feed to mirror posts on
# /writing (they link out to Substack). Leave unset to show local essays only.
SUBSTACK_FEED_URL=https://0xkhingx.substack.com/feed

# Site URL — placeholder until custom domain is purchased.
# Used for metadataBase, sitemap, and openGraph.
NEXT_PUBLIC_SITE_URL=https://0xkhingx.vercel.app

# Google Search Console — paste the verification token from
# GSC → Settings → Verification (HTML tag method, content value only).
# When set, it renders <meta name="google-site-verification" ... />.
GOOGLE_SITE_VERIFICATION=
