# Spotify Now Playing — https://developer.spotify.com/dashboard
# Create an app there, then fill these in.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Must exactly match a Redirect URI registered in your Spotify dashboard
# (register both your local dev origin and your production origin).
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/spotify/callback

# One-time setup: with the dev server running visit /api/spotify/login,
# approve access, and paste the token shown on the callback page.
SPOTIFY_REFRESH_TOKEN=

# Substack — optional. Set to your publication's feed to mirror posts on
# /writing (they link out to Substack). Leave unset to show local essays only.
SUBSTACK_FEED_URL=https://0xkhingx.substack.com/feed
